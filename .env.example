# Copy to .env and fill in. Never commit .env. List — docs/01-STACK.md.
DATABASE_URL=
BETTER_AUTH_SECRET=
PUBLIC_SITE_URL=http://localhost:5173
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Bucket without a public address (consent scans): the same R2 keys must reach it; CORS — PUT from the site.
# Empty — consent upload is "not available".
R2_PRIVATE_BUCKET=
MAIL_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public pages data cache, seconds (default 60; 0 — off, as in e2e)
CACHE_TTL_SECONDS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Online payment provider: empty — off; mock — development only (docs/07-PAYMENTS.md, section 4)
PAYMENT_PROVIDER=
# VPOS.am (PAYMENT_PROVIDER=vpos): merchant API token and webhook secret from VPOS; without both — off.
# Webhook URL to give VPOS: <PUBLIC_SITE_URL>/api/webhooks/vpos
PAYMENT_VPOS_API_TOKEN=
PAYMENT_VPOS_WEBHOOK_SECRET=
# true — live token (not allowed in development); empty or false — sandbox
PAYMENT_VPOS_LIVEMODE=
# Token for POST /api/cron/payments (the same value in GitHub Secrets); empty or < 32 chars — the route is 404
CRON_SECRET=
